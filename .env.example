# Modèle du fichier .env : copier en .env (à la racine du dépôt) et renseigner.
# Le .env n'est pas versionné (dépôt public) : ne jamais mettre de vraie valeur ici.

# --- Commun ---
# Clé d'API Grist (profil > Clé d'API)
GRIST_API_KEY=

# --- Feuille de route (kanban) ---
# Document Grist qui porte le kanban (CLAUDE.md : document: env:GRIST_KANBAN_DOC_ID)
GRIST_KANBAN_DOC_ID=

# --- Sync Docs → Grist (python/, dernier usage : GT CBS, archivé) ---
# URL de base de l'API Grist, par ex. https://grist.numerique.gouv.fr/api
# GRIST_API_URL=
# Document cible (GT CBS : table Chapitres)
# GRIST_SYNC_DOC_ID=
# Cookies de la session navigateur Docs (ProConnect), ils expirent :
# docs_sessionid et csrftoken
# DOCS_SESSION_ID=
# DOCS_CSRF_TOKEN=
# Facultatif (défaut : https://docs.numerique.gouv.fr)
# DOCS_BASE_URL=
# Facultatif : jeton GitHub (droit contents:write) pour héberger les images internes Docs ;
# sans lui, elles sont embarquées en base64
# GITHUB_TOKEN=
# Facultatif (défaut : nantodevison/pmd-suite-numerique)
# GITHUB_REPO=
# Facultatif (défaut : images)
# GITHUB_IMAGES_FOLDER=
